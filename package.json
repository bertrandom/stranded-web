{
  "name": "stranded-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Johnny Castaway, the 1992 screen saver, on a web page: a TypeScript port of stranded",
  "license": "GPL-3.0-or-later",
  "repository": "github:bertrandom/stranded-web",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/stranded.js"
    }
  },
  "bin": {
    "stranded-extract": "./dist/bin/extract.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "extract": "tsx scripts/extract.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json && tsc -p tsconfig.extract.json && chmod +x dist/bin/extract.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
